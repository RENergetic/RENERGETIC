        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#REN_Measurement_Type</IRI>
        <Literal>Contains information regarding the base unit, the actual unit, a (scale) factor and a few more details regarding a measurement.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#REN_Measurement_Type</IRI>
        <Literal>Measurement Type</Literal>
