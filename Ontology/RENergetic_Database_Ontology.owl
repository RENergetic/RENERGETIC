        <IRI>#User_roles</IRI>
        <Literal>The roles a user of the RENergetic system may have.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#User_roles</IRI>
        <Literal>User Roles</Literal>
    </AnnotationAssertion>
